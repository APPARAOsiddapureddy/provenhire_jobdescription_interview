{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "message": {
          "type": "string"
        },
        "photo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "type",
        "severity",
        "message",
        "id",
        "created_at"
      ]
    },
    "score": {
      "type": "number"
    },
    "ban_triggered": {
      "type": "boolean"
    }
  },
  "required": [
    "event",
    "score",
    "ban_triggered"
  ]
}
