# Web app only needs: apps/web, packages/*, and the workspace root config
# files. Everything else in this monorepo is dead weight for a Vercel build
# (or, worse, pushes the upload past Vercel's 100MB CLI limit).

# Portable local tooling / venvs — large, machine-specific, gitignored too.
.tools/
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/

# Node/build artifacts
node_modules/
**/node_modules/
.next/
**/.next/
.turbo/
dist/
**/*.tsbuildinfo
.pnpm-store/

# Not needed to build the Next.js app
/apps/agent/
/services/
/docs/
/skills/
/packaging/
/tests/
/cli/
/assets/
/supabase/

# VCS / editor
.git/
.claude/
